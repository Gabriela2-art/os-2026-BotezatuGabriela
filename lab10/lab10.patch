diff --git a/user/sysinfo.c b/user/sysinfo.c
new file mode 100644
index 0000000..42355eb
--- /dev/null
+++ b/user/sysinfo.c
@@ -0,0 +1,19 @@
+#include "kernel/types.h"
+#include "kernel/sysinfo.h"
+#include "user/user.h"
+
+int
+main(int argc, char *argv[])
+{
+  struct sysinfo info;
+
+  if (sysinfo(&info) < 0) {
+    fprintf(2, "sysinfo: failed\n");
+    exit(1);
+  }
+
+  printf("free memory: %lu bytes\n", info.freemem);
+  printf("processes:   %lu\n", info.nproc);
+
+  exit(0);
+}
diff --git a/user/trace.c b/user/trace.c
new file mode 100644
index 0000000..5c7a5df
--- /dev/null
+++ b/user/trace.c
@@ -0,0 +1,19 @@
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+
+int
+main(int argc, char *argv[])
+{
+  if (argc < 3) {
+    fprintf(2, "usage: trace mask command [args...]\n");
+    exit(1);
+  }
+  if (trace(atoi(argv[1])) < 0) {
+    fprintf(2, "trace: failed\n");
+    exit(1);
+  }
+  exec(argv[2], argv + 2);
+  fprintf(2, "trace: exec %s failed\n", argv[2]);
+  exit(1);
+}
